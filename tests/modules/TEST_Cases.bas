Private Function ZeroIfEmpty( _
    ByVal Value As Variant) _
    As Double
'
'------------------------------------------------------------------------------
'                              READ ZERO IF EMPTY
'------------------------------------------------------------------------------
' PURPOSE
'   The number a cell holds, where the expected value is zero: an empty cell
'   holds a zero.
'
' WHY THIS EXISTS
'   An empty cell is read as zero for an output whose expected value is
'   zero, and only for it, as run_cases.agrees does in the Python runner.
'
' INPUTS
'   Value
'     Variant: what a cell holds.
'
' RETURNS
'   The number; 0 for an empty cell or an empty text.
'
' BEHAVIOR
'   Returns 0 for an empty cell and for an empty text, and otherwise the
'   number that NumberOf reads.
'
' ERROR POLICY
'   As NumberOf for a cell that is not empty.
'
' DEPENDENCIES
'   NumberOf
'
' NOTES
'   None
'
' UPDATED
'   2026-11-19
'------------------------------------------------------------------------------

'------------------------------------------------------------------------------
' READ NUMBER
'------------------------------------------------------------------------------
    'An empty cell or an empty text is zero; anything else must be a number
        If IsEmpty(Value) Then
            ZeroIfEmpty = 0#
        ElseIf VarType(Value) = vbString And Len(Value) = 0 Then
            ZeroIfEmpty = 0#
        Else
            ZeroIfEmpty = NumberOf(Value)
        End If

End Function

Private Function NumberOf( _
    ByVal Value As Variant) _
    As Double
'
'------------------------------------------------------------------------------
'                                  READ NUMBER
'------------------------------------------------------------------------------
' PURPOSE
'   The number a cell holds, for an assertion that compares numbers.
'
' WHY THIS EXISTS
'   An empty cell, a text or an error value read as 0 would pass a
'   comparison with zero.
'
' INPUTS
'   Value
'     Variant: what a cell holds.
'
' RETURNS
'   The number, as a Double.
'
' BEHAVIOR
'   Checks that Value is a number and converts it to a Double.
'
' ERROR POLICY
'   Raises error 13 when Value is not a number, so that an empty cell, a
'   text or an error value is never compared as 0; the case records it.
'
' DEPENDENCIES
'   IsNumberValue of CORE_Util
'
' NOTES
'   None
'
' UPDATED
'   2026-11-19
'------------------------------------------------------------------------------

'------------------------------------------------------------------------------
' READ NUMBER
'------------------------------------------------------------------------------
    'Refuse a value that is not a number, and convert the others
        If Not IsNumberValue(Value) Then
            Err.Raise 13, "TEST_Cases.NumberOf", "The result is not a number."
        End If
        NumberOf = CDbl(Value)

End Function
