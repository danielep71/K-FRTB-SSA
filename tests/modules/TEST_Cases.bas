Private Sub CaseIllustrativeCoMatchedPositions()
'
'==============================================================================
'                      CaseIllustrativeCoMatchedPositions
'------------------------------------------------------------------------------
' PURPOSE
'   Test case illustrative-co-matched-positions, on CALC-05: A commodity
'   whose long and short positions offset in full, which leaves only the
'   charge on gross positions, a commodity with one position and a position
'   of zero quantity.
'
' STATE OWNERSHIP
'   Replaces the inputs of the workbook and rewrites the output
'   sheets; puts the inputs back and clears the output sheets.
'
' UPDATED
'   2026-11-16
'==============================================================================
'
    Dim ResultText   As String    'RunSSA_Silent result line, not compared
    Dim Actual       As Double    'Number read from the workbook
    Dim RestoreDue   As Boolean   'True once the inputs are kept
    Dim Detail       As String    'Why the sheets could not be restored

        On Error GoTo CaseFailed
        TEST_Harness.BeginCase "illustrative-co-matched-positions"
        KeepInputs
        RestoreDue = True
        InputsIllustrativeCoMatchedPositions
        ResultText = RunSSA_Silent()
        TEST_Harness.AssertEqualText "co-position-status-of-c-1", "OK", _
            PlainText(RowCell(NM_CO_CALC_HEADER, 1, 1))
        TEST_Harness.AssertEqualText "co-position-status-of-c-2", "OK", _
            PlainText(RowCell(NM_CO_CALC_HEADER, 2, 1))
        TEST_Harness.AssertEqualText "co-position-status-of-c-3", "OK", _
            PlainText(RowCell(NM_CO_CALC_HEADER, 3, 1))
        TEST_Harness.AssertEqualText "co-position-status-of-c-4", "OK", _
            PlainText(RowCell(NM_CO_CALC_HEADER, 4, 1))
        Actual = NumberOf(ResultsCell(3, 3))
        TEST_Harness.AssertNear "co-directional-charge", 37500, Actual, 0.000001, 0.000000001
        TEST_Harness.RecordResult "illustrative-co-matched-positions", vbNullString, _
            "co_directional_charge", vbNullString, vbNullString, Actual
        Actual = NumberOf(ResultsCell(3, 4))
        TEST_Harness.AssertNear "co-gross-charge", 60420, Actual, 0.000001, 0.000000001
        TEST_Harness.RecordResult "illustrative-co-matched-positions", vbNullString, _
            "co_gross_charge", vbNullString, vbNullString, Actual

CleanUp:
        On Error GoTo 0
        If RestoreDue Then
            Detail = RestoreInputs()
        End If
        TEST_Harness.AssertTrue "inputs-restored", Len(Detail) = 0, Detail
        Exit Sub

CaseFailed:
        TEST_Harness.RecordCaseError
        Resume CleanUp

End Sub


