Private Function CurrencyRow( _
    ByVal HeaderName As String, _
    ByVal ColumnOffset As Long, _
    ByVal Code As String) _
    As Range
'
'------------------------------------------------------------------------------
'                               FIND CURRENCY ROW
'------------------------------------------------------------------------------
' PURPOSE
'   The row of a table by currency: the first row under the header whose
'   code is the one given, without regard to case.
'
' WHY THIS EXISTS
'   The row of a currency in a table is found by its code, not by its
'   position.
'
' INPUTS
'   HeaderName
'     String: workbook name of the table's header cell.
'
'   ColumnOffset
'     Long: column of the code, to the right of the header.
'
'   Code
'     String: currency code.
'
' RETURNS
'   The cell of that row in the header's column.
'
' BEHAVIOR
'   Searches the rows under the header, up to SEARCH_ROWS, for a code equal
'   to Code once both are normalised by CodeText, and returns the header's
'   cell of the first row that matches.
'
' ERROR POLICY
'   Raises error 5 when no row within SEARCH_ROWS holds the code; the case
'   records it.
'
' DEPENDENCIES
'   CodeText of CORE_Util; SEARCH_ROWS
'
' NOTES
'   None
'
' UPDATED
'   2026-11-19
'------------------------------------------------------------------------------

'------------------------------------------------------------------------------
' DECLARE
'------------------------------------------------------------------------------
    Dim Header  As Range    'Header cell
    Dim r       As Long     'Row under the header

'------------------------------------------------------------------------------
' LOCATE HEADER
'------------------------------------------------------------------------------
    'Take the header cell of the table
        Set Header = ThisWorkbook.Names(HeaderName).RefersToRange

'------------------------------------------------------------------------------
' SEARCH ROWS
'------------------------------------------------------------------------------
    'Return the row whose code is the one given, whatever its case
        For r = 1 To SEARCH_ROWS
            If CodeText(Header.Offset(r, ColumnOffset).Value) = CodeText(Code) Then
                Set CurrencyRow = Header.Offset(r, 0)
                Exit Function
            End If
        Next r

'------------------------------------------------------------------------------
' RAISE NOT FOUND
'------------------------------------------------------------------------------
    'No row holds the code
        Err.Raise 5, "TEST_Cases.CurrencyRow", "No row of " & HeaderName & " holds " & Code & "."

End Function

Private Function ZonesTotal( _
    ByVal Code As String, _
    ByVal ColumnOffsets As Variant) _
    As Double
'
'------------------------------------------------------------------------------
'                                SUM ZONES CELLS
'------------------------------------------------------------------------------
' PURPOSE
'   The sum of some cells of a currency's row of IR_Zones.
'
' WHY THIS EXISTS
'   Some expected outputs are sums of several columns of the zones table.
'
' INPUTS
'   Code
'     String: currency code.
'
'   ColumnOffsets
'     Variant: the columns to add, to the right of the currency.
'
' RETURNS
'   The sum; an empty cell adds nothing.
'
' BEHAVIOR
'   Finds the currency's row of the zones table and adds the cells at the
'   column offsets given, an empty cell as zero.
'
' ERROR POLICY
'   As CurrencyRow, and NumberOf for a cell that holds no number.
'
' DEPENDENCIES
'   CurrencyRow; ZeroIfEmpty; the NM_ZONES_HEADER name of CORE_Config
'
' NOTES
'   None
'
' UPDATED
'   2026-11-19
'------------------------------------------------------------------------------

'------------------------------------------------------------------------------
' DECLARE
'------------------------------------------------------------------------------
    Dim First   As Range    'The currency's cell
    Dim Item    As Variant  'One column offset
    Dim Total   As Double   'Sum

'------------------------------------------------------------------------------
' LOCATE ROW
'------------------------------------------------------------------------------
    'Find the row of the currency in the zones table
        Set First = CurrencyRow(NM_ZONES_HEADER, 0, Code)

'------------------------------------------------------------------------------
' ADD CELLS
'------------------------------------------------------------------------------
    'Add the cell at each column offset
        For Each Item In ColumnOffsets
            Total = Total + ZeroIfEmpty(First.Offset(0, CLng(Item)).Value)
        Next Item

'------------------------------------------------------------------------------
' RETURN SUM
'------------------------------------------------------------------------------
    'Return the sum
        ZonesTotal = Total

End Function

