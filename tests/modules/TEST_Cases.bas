Private Sub PutRow( _
    ByVal HeaderName As String, _
    ByVal Index As Long, _
    ByVal Values As Variant)
'
'==============================================================================
'                                    PutRow
'------------------------------------------------------------------------------
' PURPOSE
'   Type one row of a position sheet.
'
' INPUTS
'   HeaderName   Workbook name of the sheet's header cell.
'   Index        Row under the header, from 1.
'   Values       The cells of the row from the PositionID; Empty leaves a
'                cell empty.
'
' UPDATED
'   2026-11-17
'==============================================================================
'
    Dim Target   As Range   'First cell of the row
    Dim c        As Long    'Cell of the row

        Set Target = ThisWorkbook.Names(HeaderName).RefersToRange.Offset(Index, 0)
        For c = LBound(Values) To UBound(Values)
            If Not IsEmpty(Values(c)) Then
                Target.Offset(0, c - LBound(Values)).Value = Typed(Values(c))
            End If
        Next c

End Sub


Private Function Typed( _
    ByVal Value As Variant) _
    As Variant
'
'==============================================================================
'                                     Typed
'------------------------------------------------------------------------------
' PURPOSE
'   A value as it is assigned to a cell so that the cell holds it as the
'   test case gives it: a text stays a text.
'
' RETURNS
'   A text with an apostrophe before it, which makes the cell hold the
'   text as typed: without it, a text that reads as a number or a date
'   becomes one. Any other value unchanged.
'
' UPDATED
'   2026-11-17
'==============================================================================
'
        If VarType(Value) = vbString Then
            Typed = "'" & Value
        Else
            Typed = Value
        End If

End Function


