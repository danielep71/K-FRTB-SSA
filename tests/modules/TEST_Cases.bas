Private Sub PutRow( _
    ByVal HeaderName As String, _
    ByVal Index As Long, _
    ByVal Values As Variant)
'
'------------------------------------------------------------------------------
'                                 PUT INPUT ROW
'------------------------------------------------------------------------------
' PURPOSE
'   Type one row of a position sheet or of Eligibility.
'
' WHY THIS EXISTS
'   The positions and the month ends of a test case are typed one row at a
'   time, from the first column of the table on.
'
' INPUTS
'   HeaderName
'     String: workbook name of the sheet's header cell.
'
'   Index
'     Long: row under the header, from 1.
'
'   Values
'     Variant: the cells of the row from the header's column: the
'     PositionID, or the month end; Empty leaves a cell empty.
'
' RETURNS
'   Nothing
'
' BEHAVIOR
'   Finds the row Index under the header and types each value of Values in
'   the cells of the row, from the header's column to the right.
'
' ERROR POLICY
'   None
'
' DEPENDENCIES
'   PutValue
'
' NOTES
'   None
'
' UPDATED
'   2026-11-19
'------------------------------------------------------------------------------

'------------------------------------------------------------------------------
' DECLARE
'------------------------------------------------------------------------------
    Dim Target  As Range    'First cell of the row
    Dim c       As Long     'Cell of the row

'------------------------------------------------------------------------------
' LOCATE ROW
'------------------------------------------------------------------------------
    'Take the first cell of the row under the header
        Set Target = ThisWorkbook.Names(HeaderName).RefersToRange.Offset(Index, 0)

'------------------------------------------------------------------------------
' TYPE CELLS
'------------------------------------------------------------------------------
    'Type each value that is not Empty in its cell of the row
        For c = LBound(Values) To UBound(Values)
            If Not IsEmpty(Values(c)) Then
                PutValue Target.Offset(0, c - LBound(Values)), Values(c)
            End If
        Next c

End Sub

Private Sub PutValue( _
    ByVal Target As Range, _
    ByVal Value As Variant)
'
'------------------------------------------------------------------------------
'                                   PUT VALUE
'------------------------------------------------------------------------------
' PURPOSE
'   Type a value in a cell so that the cell holds it as the test case gives
'   it: a text stays a text.
'
' WHY THIS EXISTS
'   A text that reads as a number, a date or a logical value would become
'   one when it is written. It is written with the cell formatted as text,
'   and the cell gets its format back; typing an apostrophe before the text
'   would leave the apostrophe in a cell that is already formatted as text.
'
' INPUTS
'   Target
'     Range: the cell.
'
'   Value
'     Variant: what it holds; any other value than a text is written as it
'     is.
'
' RETURNS
'   Nothing
'
' BEHAVIOR
'   Writes a value that is not a text as it is. For a text, saves the number
'   format of the cell, writes the text as it is when the cell is already
'   formatted as text, and otherwise formats the cell as text for the write
'   and puts the format back.
'
' ERROR POLICY
'   An error of the write is raised again once the format is back.
'
' DEPENDENCIES
'   None
'
' NOTES
'   Changes the number format of Target for the write and puts it back, on
'   the success and the error path.
'
' UPDATED
'   2026-11-19
'------------------------------------------------------------------------------

'------------------------------------------------------------------------------
' DECLARE
'------------------------------------------------------------------------------
    Dim Saved           As String   'Number format of the cell
    Dim ErrNumber       As Long     'Error of the write; 0 for none
    Dim ErrSource       As String   'Its source
    Dim ErrDescription  As String   'Its description

'------------------------------------------------------------------------------
' WRITE OTHER VALUES
'------------------------------------------------------------------------------
    'Write a value that is not a text as it is
        If VarType(Value) <> vbString Then
            Target.Value = Value
            Exit Sub
        End If

'------------------------------------------------------------------------------
' CHECK FORMAT
'------------------------------------------------------------------------------
    'Keep the number format of the cell
        Saved = CStr(Target.NumberFormat)
    'A cell that is formatted as text already holds the text as typed
        If Saved = "@" Then
            Target.Value = Value
            Exit Sub
        End If

'------------------------------------------------------------------------------
' WRITE TEXT
'------------------------------------------------------------------------------
    'Keep an error of the write, so that the format is put back
        On Error GoTo Failed
    'Format the cell as text for the write
        Target.NumberFormat = "@"
        Target.Value = Value

'------------------------------------------------------------------------------
' RESTORE FORMAT
'------------------------------------------------------------------------------
Restored:
    'Stop catching errors before the format is put back
        On Error GoTo 0
    'Put the number format of the cell back
        Target.NumberFormat = Saved
    'Raise the error of the write again, now that the format is back
        If ErrNumber <> 0 Then Err.Raise ErrNumber, ErrSource, ErrDescription

'------------------------------------------------------------------------------
' EXIT PROCEDURE
'------------------------------------------------------------------------------
    'Leave before the error handler
        Exit Sub

'------------------------------------------------------------------------------
' ERROR HANDLER
'------------------------------------------------------------------------------
Failed:
    'Keep the error of the write
        ErrNumber = Err.Number
        ErrSource = Err.Source
        ErrDescription = Err.Description
    'Go on to put the format back
        Resume Restored

End Sub

