' CLEAN UP
'------------------------------------------------------------------------------
CleanUp:
    'Stop catching errors, so that an error of the cleanup cannot come back here
        On Error GoTo 0
    'Put the sheets back as they were, on the success and the error path
        If RestoreDue Then
            Detail = RestoreInputs()
