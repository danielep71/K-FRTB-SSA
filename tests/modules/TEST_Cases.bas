Private Sub AllowWritingToSheets()

'
'------------------------------------------------------------------------------
'                            ALLOW WRITING TO SHEETS
'------------------------------------------------------------------------------
' PURPOSE
'   Let the suite write the sheets of its workbook, which the template
'   protects: apply UserInterfaceOnly to each of them, as AllowWriting does
'   for the sheets that RunSSA writes.
'
' WHY THIS EXISTS
'   The cases type their inputs on sheets that the template protects.
'
' INPUTS
'   None
'
' RETURNS
'   Nothing
'
' BEHAVIOR
'   Calls AllowWriting for every worksheet of the workbook.
'
' ERROR POLICY
'   None of its own; an error of AllowWriting propagates.
'
' DEPENDENCIES
'   AllowWriting of M_Main; ThisWorkbook.Worksheets
'
' NOTES
'   Changes the protection mode of every sheet, not who may change it.
'
' UPDATED
'   2026-11-19
'------------------------------------------------------------------------------

'------------------------------------------------------------------------------
' DECLARE
'------------------------------------------------------------------------------
    Dim Sheet   As Worksheet    'One sheet

'------------------------------------------------------------------------------
' ALLOW WRITING
'------------------------------------------------------------------------------
    'Apply UserInterfaceOnly to every sheet of the workbook
        For Each Sheet In ThisWorkbook.Worksheets
            AllowWriting Sheet
        Next Sheet

End Sub

Private Function InputArea( _
    ByVal Index As Long) _
    As Range
'
'------------------------------------------------------------------------------
'                                GET INPUT AREA
'------------------------------------------------------------------------------
' PURPOSE
'   One of the areas that hold the inputs a test case replaces.
'
' WHY THIS EXISTS
'   A case keeps, clears, types and restores its inputs area by area, and
'   the areas are numbered so that one loop can visit them all.
'
' INPUTS
'   Index
'     Long: 1 to 4: the rows of the four position sheets, as many as
'     PositionRows gives; 5: the FX table, with its descriptions; 6 and 7:
'     the reporting date and currency; 8 to 11: the option charges; 12 and
'     13: the regime and the total own funds; 14: the input columns of the
'     rows of Eligibility.
'
' RETURNS
'   The range of the area. Nothing for an Index outside 1 to 14, since the
'   selection has no other branch.
'
' BEHAVIOR
'   Returns the range of the area that Index names: the table of a position
'   sheet with the rows PositionRows gives, the FX table, the reporting
'   date, the reporting currency, the option charge of a risk class, the
'   regime, the total own funds or the month ends of Eligibility.
'
' ERROR POLICY
'   None
'
' DEPENDENCIES
'   PositionHeader; PositionRows; the IR_, EQ_ and FX_ and CO_INPUT_WIDTH,
'   NM_EL_HEADER, ELIGIBILITY_ROWS and EL_INPUT_WIDTH constants of
'   CORE_Config; the workbook's names
'
' NOTES
'   None
'
' UPDATED
'   2026-11-19
'------------------------------------------------------------------------------

'------------------------------------------------------------------------------
' DECLARE
'------------------------------------------------------------------------------
    Dim Header  As Range    'Header of a position sheet
    Dim Codes   As Range    'FX table codes
    Dim Rates   As Range    'FX table rates

'------------------------------------------------------------------------------
' SELECT AREA
'------------------------------------------------------------------------------
    'Pick the area by its number: position sheets, FX table, date, currency, charges
        Select Case Index
            Case 1: Set Header = PositionHeader(1)
                    Set InputArea = Header.Offset(1, 0).Resize(PositionRows(1), IR_INPUT_WIDTH)
            Case 2: Set Header = PositionHeader(2)
                    Set InputArea = Header.Offset(1, 0).Resize(PositionRows(2), EQ_INPUT_WIDTH)
            Case 3: Set Header = PositionHeader(3)
                    Set InputArea = Header.Offset(1, 0).Resize(PositionRows(3), CO_INPUT_WIDTH)
            Case 4: Set Header = PositionHeader(4)
                    Set InputArea = Header.Offset(1, 0).Resize(PositionRows(4), FX_INPUT_WIDTH)
            Case 5: Set Codes = ThisWorkbook.Names(NM_FX_CCY).RefersToRange
                    Set Rates = ThisWorkbook.Names(NM_FX_RATE).RefersToRange
                    Set InputArea = Codes.Resize(Codes.Rows.Count, _
                                                 Rates.Column - Codes.Column + 1)
            Case 6: Set InputArea = ThisWorkbook.Names("AsOfDate").RefersToRange
            Case 7: Set InputArea = ThisWorkbook.Names("ReportingCcy").RefersToRange
            Case 8: Set InputArea = ThisWorkbook.Names(NM_OPTIONS_PREFIX & "IR").RefersToRange
            Case 9: Set InputArea = ThisWorkbook.Names(NM_OPTIONS_PREFIX & "EQ").RefersToRange
            Case 10: Set InputArea = ThisWorkbook.Names(NM_OPTIONS_PREFIX & "CO").RefersToRange
            Case 11: Set InputArea = ThisWorkbook.Names(NM_OPTIONS_PREFIX & "FX").RefersToRange
            Case 12: Set InputArea = ThisWorkbook.Names("Regime").RefersToRange
            Case 13: Set InputArea = ThisWorkbook.Names("TotalOwnFunds").RefersToRange
            Case 14: Set InputArea = ThisWorkbook.Names(NM_EL_HEADER).RefersToRange _
                        .Offset(1, 0).Resize(ELIGIBILITY_ROWS, EL_INPUT_WIDTH)
        End Select

End Function

Private Function PositionHeader( _
    ByVal Index As Long) _
    As Range
'
'------------------------------------------------------------------------------
'                              GET POSITION HEADER
'------------------------------------------------------------------------------
' PURPOSE
'   The header cell of one of the four position sheets.
'
' WHY THIS EXISTS
'   Four sheets hold positions and each has its own header name; callers
'   hold the sheet as a number.
'
' INPUTS
'   Index
'     Long: 1 interest rate, 2 equity, 3 commodity, 4 foreign exchange.
'
' RETURNS
'   The header cell. Nothing for an Index outside 1 to 4, since the
'   selection has no other branch.
'
' BEHAVIOR
'   Maps the number to the workbook name of the sheet's header cell and
'   returns the cell that name refers to.
'
' ERROR POLICY
'   None
'
' DEPENDENCIES
'   The NM_IR_POS_HEADER, NM_EQ_POS_HEADER, NM_CO_POS_HEADER and
'   NM_FX_POS_HEADER names of CORE_Config
'
' NOTES
'   None
'
' UPDATED
'   2026-11-19
'------------------------------------------------------------------------------

'------------------------------------------------------------------------------
' SELECT HEADER
'------------------------------------------------------------------------------
    'Take the header name of the sheet the number selects
        Select Case Index
            Case 1: Set PositionHeader = ThisWorkbook.Names(NM_IR_POS_HEADER).RefersToRange
            Case 2: Set PositionHeader = ThisWorkbook.Names(NM_EQ_POS_HEADER).RefersToRange
            Case 3: Set PositionHeader = ThisWorkbook.Names(NM_CO_POS_HEADER).RefersToRange
            Case 4: Set PositionHeader = ThisWorkbook.Names(NM_FX_POS_HEADER).RefersToRange
        End Select

End Function

Private Function PositionRows( _
    ByVal Index As Long) _
    As Long
'
'------------------------------------------------------------------------------
'                               GET POSITION ROWS
'------------------------------------------------------------------------------
' PURPOSE
'   The rows of a position sheet a test case replaces and puts back: those
'   of the table, from the header to the last row that holds a PositionID,
'   as the engine reads it, and at least INPUT_ROWS.
'
' WHY THIS EXISTS
'   The table of a position sheet has no fixed length, and a case must put
'   back every row it replaced.
'
' INPUTS
'   Index
'     Long: as PositionHeader.
'
' RETURNS
'   The rows kept by the last KeepInputs; INPUT_ROWS before the first.
'
' BEHAVIOR
'   Returns the row count that KeepInputs stored for the sheet, or
'   INPUT_ROWS before the first KeepInputs.
'
' ERROR POLICY
'   None
'
' DEPENDENCIES
'   mRows; INPUT_ROWS
'
' NOTES
'   None
'
' UPDATED
'   2026-11-19
'------------------------------------------------------------------------------

'------------------------------------------------------------------------------
' RETURN ROWS
'------------------------------------------------------------------------------
    'Return the rows kept, or the least number of rows before the first keep
        If mRows(Index) > 0 Then
            PositionRows = mRows(Index)
        Else
            PositionRows = INPUT_ROWS
        End If

End Function

Private Function TableRows( _
    ByVal Index As Long) _
    As Long
'
'------------------------------------------------------------------------------
'                               COUNT TABLE ROWS
'------------------------------------------------------------------------------
' PURPOSE
'   The rows of a position sheet that hold the table now: from the row under
'   the header to the last row that holds a PositionID, as M_Main reads a
'   table, and at least INPUT_ROWS.
'
' WHY THIS EXISTS
'   KeepInputs keeps a position sheet through the rows its table holds,
'   whatever their number.
'
' INPUTS
'   Index
'     Long: as PositionHeader.
'
' RETURNS
'   The number of rows, at least INPUT_ROWS.
'
' BEHAVIOR
'   Finds the last row of the header's column that holds a value, takes its
'   distance from the header and raises it to INPUT_ROWS if it is less.
'
' ERROR POLICY
'   None
'
' DEPENDENCIES
'   PositionHeader; INPUT_ROWS
'
' NOTES
'   None
'
' UPDATED
'   2026-11-19
'------------------------------------------------------------------------------

'------------------------------------------------------------------------------
' DECLARE
'------------------------------------------------------------------------------
    Dim Header  As Range        'Header cell
    Dim Sheet   As Worksheet    'Sheet of the table
    Dim Last    As Long         'Last row under the header that holds a PositionID

'------------------------------------------------------------------------------
' LOCATE TABLE
'------------------------------------------------------------------------------
    'Take the header cell and the sheet that holds the table
        Set Header = PositionHeader(Index)
        Set Sheet = Header.Worksheet

'------------------------------------------------------------------------------
' COUNT ROWS
'------------------------------------------------------------------------------
    'Count the rows from the header to the last row of its column
        Last = Sheet.Cells(Sheet.Rows.Count, Header.Column).End(xlUp).Row - Header.Row
    'Never fewer rows than the least number kept
        If Last < INPUT_ROWS Then Last = INPUT_ROWS
        TableRows = Last

End Function

Private Sub KeepInputs()

'
'------------------------------------------------------------------------------
'                                  KEEP INPUTS
'------------------------------------------------------------------------------
' PURPOSE
'   Keep what every input area holds, before a case replaces it: its values
'   and its formulas. A position sheet is kept through the rows of its
'   table, whatever their number.
'
' WHY THIS EXISTS
'   A case replaces the inputs of the workbook and must put them back as
'   they were.
'
' INPUTS
'   None
'
' RETURNS
'   Nothing
'
' BEHAVIOR
'   Stores the rows of each position sheet, then the values and the formulas
'   of every input area.
'
' ERROR POLICY
'   None
'
' DEPENDENCIES
'   TableRows; InputArea; AsTable; INPUT_AREAS
'
' NOTES
'   State ownership: sets mRows, mKept and mFormulas.
'
' UPDATED
'   2026-11-19
'------------------------------------------------------------------------------

'------------------------------------------------------------------------------
' DECLARE
'------------------------------------------------------------------------------
    Dim i   As Long 'Input area

'------------------------------------------------------------------------------
' KEEP ROWS
'------------------------------------------------------------------------------
    'Keep the rows that the table of each position sheet holds
        For i = 1 To 4
            mRows(i) = 0
            mRows(i) = TableRows(i)
        Next i

'------------------------------------------------------------------------------
' KEEP AREAS
'------------------------------------------------------------------------------
    'Keep the values and the formulas of every input area
        For i = 1 To INPUT_AREAS
            mKept(i) = InputArea(i).Value
            mFormulas(i) = AsTable(InputArea(i).Formula)
        Next i

End Sub

Private Function RestoreInputs() As String

'
'------------------------------------------------------------------------------
'                                RESTORE INPUTS
'------------------------------------------------------------------------------
' PURPOSE
'   Put the sheets back as they were before a case: write what KeepInputs
'   kept, values and then formulas, check that every input cell holds it,
'   and clear the output sheets, which show the results of the test case.
'
' WHY THIS EXISTS
'   A case changes the inputs and the outputs of the workbook; it puts the
'   sheets back as they were, and the suite asserts it.
'
' INPUTS
'   None
'
' RETURNS
'   An empty text when the sheets are restored; otherwise what failed.
'
' BEHAVIOR
'   Empties and rewrites every input area with its kept values, writes back
'   the formulas, writes again as a text each kept text that is not a
'   formula, counts the input cells that differ from what was kept and
'   clears the output sheets.
'
' ERROR POLICY
'   Contains its own error and returns it, so that the case asserts the
'   result on the success and the error path.
'
' DEPENDENCIES
'   InputArea; AsTable; IsFormula; PutValue; InputDifferences;
'   ClearOutputs_Silent of M_Main; mKept and mFormulas
'
' NOTES
'   Writes every input area and clears the output sheets. Each area is
'   emptied before it is written: an empty value written over a cell that
'   holds something does not leave it empty in every host.
'
' UPDATED
'   2026-11-19
'------------------------------------------------------------------------------

'------------------------------------------------------------------------------
' DECLARE
'------------------------------------------------------------------------------
    Dim i           As Long     'Input area
    Dim r           As Long     'Row
    Dim c           As Long     'Column
    Dim Differences As Long     'Input cells that differ
    Dim Cleared     As String   'ClearOutputs_Silent result line

'------------------------------------------------------------------------------
' INITIALIZE
'------------------------------------------------------------------------------
    'Contain an error of the restoration and return it
        On Error GoTo Failed

'------------------------------------------------------------------------------
' WRITE INPUTS
'------------------------------------------------------------------------------
    'Empty each area before writing it, as an empty value does not clear a cell in every host
        For i = 1 To INPUT_AREAS
            InputArea(i).ClearContents
            InputArea(i).Value = mKept(i)
            'A cell that held a formula gets it back: the value above is its result
            For r = 1 To UBound(mFormulas(i), 1)
                For c = 1 To UBound(mFormulas(i), 2)
                    If IsFormula(mFormulas(i)(r, c)) Then
                        InputArea(i).Cells(r, c).Formula = mFormulas(i)(r, c)
                    End If
                Next c
            Next r
            'A text the write above made a number, a date or a logical value is a text again
            For r = 1 To UBound(mFormulas(i), 1)
                For c = 1 To UBound(mFormulas(i), 2)
                    If VarType(AsTable(mKept(i))(r, c)) = vbString Then
                        If Not IsFormula(mFormulas(i)(r, c)) Then
                            PutValue InputArea(i).Cells(r, c), AsTable(mKept(i))(r, c)
                        End If
                    End If
                Next c
            Next r
        Next i

'------------------------------------------------------------------------------
' CHECK AND CLEAR
'------------------------------------------------------------------------------
    'Count the input cells that do not hold what was kept
        Differences = InputDifferences()
    'Clear the output sheets, which show the results of the test case
        Cleared = ClearOutputs_Silent()
    'Report what failed first: the inputs, then the outputs
        If Differences <> 0 Then
            RestoreInputs = CStr(Differences) & " input cell(s) do not hold what they held"
        ElseIf Left$(Cleared, 14) <> "RESULT=CLEARED" Then
            RestoreInputs = "the output sheets are not cleared: " & Cleared
        End If

'------------------------------------------------------------------------------
' EXIT PROCEDURE
'------------------------------------------------------------------------------
    'Leave before the error handler
        Exit Function

'------------------------------------------------------------------------------
' ERROR HANDLER
'------------------------------------------------------------------------------
Failed:
    'Return the error as the result of the restoration
        RestoreInputs = "error " & CStr(Err.Number) & " while restoring: " & Err.Description

End Function

Private Function InputDifferences() As Long

'
'------------------------------------------------------------------------------
'                               COUNT DIFFERENCES
'------------------------------------------------------------------------------
' PURPOSE
'   Count the input cells that do not hold what KeepInputs kept: a value
'   that differs, a formula that differs, a formula where the cell held none
'   and none where it held one.
'
' WHY THIS EXISTS
'   RestoreInputs asserts that the sheets are as they were; this is the
'   count it asserts.
'
' INPUTS
'   None
'
' RETURNS
'   The number of cells; 0 when the inputs are those kept.
'
' BEHAVIOR
'   Reads every input area, values and formulas, and compares each cell with
'   what KeepInputs kept.
'
' ERROR POLICY
'   None
'
' DEPENDENCIES
'   InputArea; AsTable; SameValue; IsFormula; mKept and mFormulas
'
' NOTES
'   None
'
' UPDATED
'   2026-11-19
'------------------------------------------------------------------------------

'------------------------------------------------------------------------------
' DECLARE
'------------------------------------------------------------------------------
    Dim Current         As Variant  'What an area holds now: values
    Dim CurrentFormulas As Variant  'What an area holds now: formulas
    Dim i               As Long     'Input area
    Dim r               As Long     'Row
    Dim c               As Long     'Column
    Dim Count           As Long     'Cells that differ

'------------------------------------------------------------------------------
' COMPARE AREAS
'------------------------------------------------------------------------------
    'Compare every cell of every area with what was kept
        For i = 1 To INPUT_AREAS
            Current = AsTable(InputArea(i).Value)
            CurrentFormulas = AsTable(InputArea(i).Formula)
            For r = 1 To UBound(Current, 1)
                For c = 1 To UBound(Current, 2)
                    'Count a differing value, a gained or lost formula, or a differing formula
                    If Not SameValue(Current(r, c), AsTable(mKept(i))(r, c)) Then
                        Count = Count + 1
                    ElseIf IsFormula(CurrentFormulas(r, c)) <> IsFormula(mFormulas(i)(r, c)) Then
                        Count = Count + 1
                    ElseIf IsFormula(CurrentFormulas(r, c)) Then
                        If CurrentFormulas(r, c) <> mFormulas(i)(r, c) Then Count = Count + 1
                    End If
                Next c
            Next r
        Next i

'------------------------------------------------------------------------------
' RETURN COUNT
'------------------------------------------------------------------------------
    'Return the number of cells that differ
        InputDifferences = Count

End Function

Private Function AsTable( _
    ByVal Value As Variant) _
    As Variant
'
'------------------------------------------------------------------------------
'                                 RETURN TABLE
'------------------------------------------------------------------------------
' PURPOSE
'   What a range returned as a table of one or more rows and columns: an
'   area of one cell returns its value alone.
'
' WHY THIS EXISTS
'   The Value and Formula of a range of one cell are not arrays, and the
'   callers index every area by row and column.
'
' INPUTS
'   Value
'     Variant: the Value or the Formula of a range.
'
' RETURNS
'   Value when it is an array, else a table of one cell holding it.
'
' BEHAVIOR
'   Returns Value when it is an array, else a table of one cell that holds
'   it.
'
' ERROR POLICY
'   None
'
' DEPENDENCIES
'   None
'
' NOTES
'   The table of one cell is a local array that is returned by value.
'
' UPDATED
'   2026-11-19
'------------------------------------------------------------------------------

'------------------------------------------------------------------------------
' DECLARE
'------------------------------------------------------------------------------
    Dim Table(1 To 1, 1 To 1)   As Variant  'The table of one cell

'------------------------------------------------------------------------------
' RETURN TABLE
'------------------------------------------------------------------------------
    'Return an array as it is and any other value as a table of one cell
        If IsArray(Value) Then
            AsTable = Value
        Else
            Table(1, 1) = Value
            AsTable = Table
        End If

End Function

Private Function IsFormula( _
    ByVal Value As Variant) _
    As Boolean
'
'------------------------------------------------------------------------------
'                                 TEST FORMULA
'------------------------------------------------------------------------------
' PURPOSE
'   Whether what a cell holds, as its Formula returns it, is a formula.
'
' WHY THIS EXISTS
'   The Formula of a cell returns its text or its value, and the cell holds
'   a formula only when that text starts with an equals sign.
'
' INPUTS
'   Value
'     Variant: the Formula of a cell.
'
' RETURNS
'   True for a text that starts with an equals sign, else False.
'
' BEHAVIOR
'   Tests that Value is a text whose first character is an equals sign.
'
' ERROR POLICY
'   None
'
' DEPENDENCIES
'   None
'
' NOTES
'   None
'
' UPDATED
'   2026-11-19
'------------------------------------------------------------------------------

'------------------------------------------------------------------------------
' TEST VALUE
'------------------------------------------------------------------------------
    'A formula is a text that starts with an equals sign
        If VarType(Value) = vbString Then
            IsFormula = (Left$(Value, 1) = "=")
        End If

End Function

Private Function SameValue( _
    ByVal First As Variant, _
    ByVal Second As Variant) _
    As Boolean
'
'------------------------------------------------------------------------------
'                                COMPARE VALUES
'------------------------------------------------------------------------------
' PURPOSE
'   Whether two cell values are the same value of the same type.
'
' WHY THIS EXISTS
'   The check of the restored inputs compares what a cell holds now with
'   what was kept, and a value must be equal in type as well as in content.
'
' INPUTS
'   First
'     Variant: a cell value.
'
'   Second
'     Variant: a cell value.
'
' RETURNS
'   True when the values are the same, else False.
'
' BEHAVIOR
'   Compares the types first, then treats two empty values as equal, two
'   error values by their text and any other pair by comparison.
'
' ERROR POLICY
'   An error value equals only the same error value.
'
' DEPENDENCIES
'   None
'
' NOTES
'   None
'
' UPDATED
'   2026-11-19
'------------------------------------------------------------------------------

'------------------------------------------------------------------------------
' COMPARE
'------------------------------------------------------------------------------
    'Values of another type differ; compare the others by their kind
        If VarType(First) <> VarType(Second) Then
            SameValue = False
        ElseIf IsEmpty(First) Then
            SameValue = True
        ElseIf IsError(First) Then
            SameValue = (CStr(First) = CStr(Second))
        Else
            SameValue = (First = Second)
        End If

End Function

Private Sub ClearInputs()

'
'------------------------------------------------------------------------------
'                                 CLEAR INPUTS
'------------------------------------------------------------------------------
' PURPOSE
'   Empty every input area a test case fills: the position sheets, the FX
'   table, the option charges, the total own funds and the month ends. The
'   reporting date and currency and the regime are always set by the case.
'
' WHY THIS EXISTS
'   A case replaces the inputs of the workbook with those of its test case,
'   so the areas it fills must be empty before it types.
'
' INPUTS
'   None
'
' RETURNS
'   Nothing
'
' BEHAVIOR
'   Clears the contents of every input area except 6, 7 and 12, the
'   reporting date and currency and the regime.
'
' ERROR POLICY
'   None
'
' DEPENDENCIES
'   InputArea; INPUT_AREAS
'
' NOTES
'   Clears the contents of those areas; their formats stay.
'
' UPDATED
'   2026-11-19
'------------------------------------------------------------------------------

'------------------------------------------------------------------------------
' DECLARE
'------------------------------------------------------------------------------
    Dim i   As Long 'Input area

'------------------------------------------------------------------------------
' CLEAR AREAS
'------------------------------------------------------------------------------
    'Empty every area but the reporting date and currency and the regime
        For i = 1 To INPUT_AREAS
            If i <> 6 And i <> 7 And i <> 12 Then InputArea(i).ClearContents
        Next i

End Sub

