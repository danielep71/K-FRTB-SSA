'------------------------------------------------------------------------------
    'Compare eq_position_status of X-DUP with its expected text
        TEST_Harness.AssertEqualText "eq-position-status-of-x-dup-output-1", _
            "INVALID: duplicate PositionID", PlainText(RowCell(NM_EQ_CALC_HEADER, 1, 1))
