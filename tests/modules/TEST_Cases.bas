Attribute VB_Name = "TEST_Cases"
'==============================================================================
' MODULE: TEST_Cases
'------------------------------------------------------------------------------
' PURPOSE
'   The cases suite of the workbook's tests: every registered test case of
'   the project's calculations, as a case of TEST_Harness that types the
'   test case's inputs on the input sheets, runs the calculation through
'   RunSSA_Silent and compares every expected output with the cell that
'   holds it. GENERATED by tools/prototype/case_suite.py from tests/fixtures/
'   and tests/expected/: do not edit it; change the test case and write the
'   module again.
'
' PUBLIC SURFACE
'   RunCaseTests is the documented test entry point. Test_RunCases runs the
'   same suite and returns its result line where a caller cannot read an
'   error, as tools/devbuild/lo_macro.py. CertifyCases certifies the run and
'   saves its log, its results and its certification log as evidence of an
'   Excel run. Option Private Module keeps them out of the workbook's
'   external surface. Never part of the production import set.
'
' DEPENDENCIES
'   TEST_Harness; M_Main, CORE_Config and CORE_Util; the workbook's names
'   and sheets.
'
' STATE OWNERSHIP
'   Owns the copy of the inputs a case keeps while it runs: their values and
'   their formulas. Each case
'   replaces the inputs of the workbook with those of its test case: the
'   reporting date and currency, the FX table, the option charges and the
'   four position sheets. It puts back the inputs the workbook had, on the
'   success and the error path, and asserts it. It rewrites the output
'   sheets through RunSSA_Silent and clears them when it puts the inputs
'   back.
'
' ERROR POLICY
'   As TEST_Harness.EndRun: a run that does not pass raises ERR_TEST_FAILED,
'   or the unexpected error that escaped the runner. A refused start raises
'   TEST_Harness.ERR_TEST_DIRTY_START. An unexpected error inside a case is
'   recorded as a failure of that case, and the run continues. Test_RunCases
'   contains those errors; CertifyCases records them, saves the log, and
'   raises only when the certification did not pass.
'
' USAGE
'   In a development workbook, type TEST_Cases.RunCaseTests in the Immediate
'   window. To record an Excel run, type
'   TEST_Cases.CertifyCases "<folder>", "<checkout>\tests\fixtures"
'   (INSTALLATION.md, Recording an Excel run).
'
' COMPATIBILITY
'   Excel VBA; also runs under LibreOffice's VBA mode through the tools of
'   tools/devbuild/, which is never Excel evidence.
'
' REFERENCE
'   Each expected value, its class and its tolerance are those of the test
'   case's file in tests/expected/ (docs/methodology/TEST_CASES.md).
'
' UPDATED
'   2026-11-17
'
' AUTHOR
'   Daniele Penza
'==============================================================================

'------------------------------------------------------------------------------
' MODULE SETTINGS
'------------------------------------------------------------------------------
    'Require explicit declarations; keep the tests inside this project.
    Option Explicit
    Option Private Module

'------------------------------------------------------------------------------
' MODULE CONSTANTS
'------------------------------------------------------------------------------
    'A complete run starts every case and evaluates every assertion once.
        Private Const SUITE_NAME          As String = "cases"
        Private Const EXPECTED_CASES      As Long = 18
        Private Const EXPECTED_ASSERTIONS As Long = 345
    'The inputs a test case replaces (InputArea).
        Private Const INPUT_AREAS         As Long = 11    'Areas kept and put back
        Private Const INPUT_ROWS          As Long = 500   'Rows of a position sheet kept and cleared
    'Where a result per currency is found.
        Private Const SEARCH_ROWS         As Long = 60    'Rows searched under a header
        Private Const FX_BLOCK_CODE       As Long = 1     'Buckets FX block: currency
        Private Const FX_BLOCK_NET        As Long = 5     'Buckets FX block: net position

'------------------------------------------------------------------------------
' MODULE STATE
'------------------------------------------------------------------------------
        Private mKept(1 To 11)   As Variant   'What each input area held: values
        Private mFormulas(1 To 11) As Variant 'What each input area held: formulas



'------------------------------------------------------------------------------
'                                 ENTRY POINTS
'------------------------------------------------------------------------------

Public Sub RunCaseTests()
'
'==============================================================================
'                                 RunCaseTests
'------------------------------------------------------------------------------
' PURPOSE
'   Run the cases suite. A passing run ends with
'   RESULT=PASS; suite=cases; operation=PASS; completeness=COMPLETE;
'   cases=18; assertions=345; failures=0; cleanup=PASS; recovery=NONE.
'
' STATE OWNERSHIP
'   Replaces the inputs for each case and puts them back; leaves the
'   output sheets cleared.
'
' ERROR POLICY
'   As TEST_Harness.EndRun: raises when the run does not pass.
'
' UPDATED
'   2026-11-17
'==============================================================================
'
        RunSuite

End Sub


Public Function Test_RunCases() As String
'
'==============================================================================
'                                 Test_RunCases
'------------------------------------------------------------------------------
' PURPOSE
'   Run the cases suite for a caller that reads a result and not an error.
'
' RETURNS
'   The RESULT line of the run, as TEST_Harness.LastResult gives it.
'
' STATE OWNERSHIP
'   As RunCaseTests.
'
' ERROR POLICY
'   Contains the error of a run that does not pass, or of a refused start:
'   the result line says so.
'
' UPDATED
'   2026-11-17
'==============================================================================
'
        On Error Resume Next
        RunSuite
        On Error GoTo 0
        Test_RunCases = TEST_Harness.LastResult()

End Function


Public Sub CertifyCases( _
    ByVal Folder As String, _
    ByVal Fixtures As String)
'
'==============================================================================
'                                 CertifyCases
'------------------------------------------------------------------------------
' PURPOSE
'   Certify the cases suite's run as evidence of an Excel run: run it, save
'   its log as cases.log and its results as cases-results.json, and write
'   cases-certification.log.
'
' INPUTS
'   Folder: an existing folder for the files, without a trailing separator.
'   Fixtures: the full path of tests/fixtures/ in the checkout; not read,
'   because the inputs are in this module, and taken so that every
'   certification entry point has the same two arguments.
'
' STATE OWNERSHIP
'   As RunCaseTests.
'
' ERROR POLICY
'   The error of the run is recorded, not raised, so that the log is always
'   saved. Raises ERR_TEST_FAILED after writing the certification log when
'   the certification did not pass. An error of BeginCertification,
'   SaveLog or SaveResults propagates; run TEST_Harness.ResetTests before
'   trying again.
'
' UPDATED
'   2026-11-17
'==============================================================================
'
    Dim RunErrorNumber        As Long     'Error that ended the run; 0 for none
    Dim RunErrorDescription   As String   'Its description

        TEST_Harness.BeginCertification SUITE_NAME
        On Error Resume Next
        RunSuite
        RunErrorNumber = Err.Number
        RunErrorDescription = Err.Description
        On Error GoTo 0
        TEST_Harness.SaveLog Folder & "\cases.log"
        TEST_Harness.Echo "SAVED=" & Folder & "\cases.log; mode=NORMAL; error=" & _
            CStr(RunErrorNumber) & IIf(RunErrorNumber = 0, vbNullString, " " & RunErrorDescription)
        TEST_Harness.CertifyRun "NORMAL", True, RunErrorNumber, RunErrorDescription
        TEST_Harness.SaveResults Folder & "\cases-results.json"
        TEST_Harness.EndCertification Folder & "\cases-certification.log"

End Sub


'------------------------------------------------------------------------------
'                                    RUNNER
'------------------------------------------------------------------------------

Private Sub RunSuite()
'
'==============================================================================
'                                   RunSuite
'------------------------------------------------------------------------------
' PURPOSE
'   Run every case in a fixed order between BeginRun and EndRun.
'
' ERROR POLICY
'   An error escaping a case handler is passed to EndRun, which reports it
'   and re-raises it unchanged. BeginRun's refusal propagates directly.
'
' UPDATED
'   2026-11-17
'==============================================================================
'
    Dim ErrNumber        As Long     'Runner error number; 0 for none
    Dim ErrSource        As String   'Runner error source
    Dim ErrDescription   As String   'Runner error description

        TEST_Harness.BeginRun SUITE_NAME, "NORMAL", EXPECTED_CASES, EXPECTED_ASSERTIONS
        On Error GoTo RunFailed
        CaseIllustrativeCoMatchedPositions
        CaseIllustrativeEqMatchedPositions
        CaseIllustrativeFxOneSidedPositions
        CaseIllustrativeInvalidCoPositions
        CaseIllustrativeInvalidEqPositions
        CaseIllustrativeInvalidFxPositions
        CaseIllustrativeInvalidIrPositions
        CaseIllustrativeIrSpecificRiskMaturityLimits
        CaseIllustrativeIrTimeBandLimits
        CaseIllustrativeOptionCharges
        CaseIllustrativeRequirementFxAndOptionsOnly
        CaseIllustrativeSampleCommodities
        CaseIllustrativeSampleEquity
        CaseIllustrativeSampleFx
        CaseIllustrativeSampleIrGeneralMarketRisk
        CaseIllustrativeSampleIrSpecificRisk
        CaseIllustrativeSampleRequirement
        CaseMar4061Table9

Finish:
        On Error GoTo 0
        TEST_Harness.EndRun ErrNumber, ErrSource, ErrDescription
        Exit Sub

RunFailed:
        ErrNumber = Err.Number
        ErrSource = Err.Source
        ErrDescription = Err.Description
        Resume Finish

End Sub


