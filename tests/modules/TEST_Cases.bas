Private Sub PutRate( _
    ByVal Index As Long, _
    ByVal Code As String, _
    ByVal Rate As Variant)
'
'==============================================================================
'                                    PutRate
'------------------------------------------------------------------------------
' PURPOSE
'   Type one row of the FX table: a currency and its rate.
'
' INPUTS
'   Index   Row of the table, from 1.
'   Code    Currency code.
'   Rate    Its rate; Empty leaves the cell empty.
